APP_URL=http://localhost/sportmanager

# Configuracion SMTP para recuperacion de contraseña
# Para un servicio externo real, usa un proveedor como SendGrid, Mailgun o SMTP2GO.
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=apikey
MAIL_PASSWORD=tu_api_key_o_contrasena_de_aplicacion
MAIL_FROM_ADDRESS=no-reply@tu-dominio.com
MAIL_FROM_NAME=Sport Manager

