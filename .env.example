# Correo - SendGrid API HTTP (reemplaza SMTP, funciona en byethost y hostings con SMTP bloqueado)
# Obtén tu API Key en: https://app.sendgrid.com/settings/api_keys
# El remitente (MAIL_FROM_ADDRESS) debe estar verificado en SendGrid como Sender Identity.
SENDGRID_API_KEY=tu_sendgrid_api_key_aqui
MAIL_FROM_ADDRESS=no-reply@tu-dominio.com
MAIL_FROM_NAME=Sport Manager


